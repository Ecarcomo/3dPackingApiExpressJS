# Clave compartida entre backend y cliente. En Render: Environment → add API_KEY.
# Si API_KEY está vacía o no existe, el servidor no exige cabecera (solo desarrollo).
API_KEY=

PORT=5501
CORS_ORIGIN=http://localhost:5173

# Cliente (ej. Vite): en el .env del front, misma clave con prefijo público:
# VITE_API_KEY=
# y enviar cabecera: x-api-key: <valor>
# Ojo: en el navegador el valor de VITE_* es visible; para APIs sensibles usa proxy en tu propio backend.